# Local only. Never commit real secrets. Production uses AWS Secrets Manager.

DATABASE_URL=postgresql://harmony:harmony@localhost:5433/harmony
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# AUTH_MODE=dev lets you pick a seeded user. Never set this in production.
AUTH_MODE=dev
DEV_USER_EMAIL=doc@thrivingharmony.example

TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_E164=

# local | s3
OBJECT_STORE=local
LOCAL_OBJECT_DIR=./data/objects
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_KMS_KEY_ID=

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
